# Copy to .env and adjust if you need to.
PROVIDER_URL=http://localhost:8080
PROVIDER_API_KEY=interview-key
REDIS_URL=redis://localhost:6380/0

# Selects the limiter that loadtest and tests use. "noop" is the starting state;
# register your own in limiter/__init__.py and name it here.
LIMITER=noop

# Provider knobs. You may change these while exploring, but your solution is
# graded against the defaults.
FAKE_PROVIDER_WINDOW=fixed
FAKE_PROVIDER_SEED=1337
FAKE_PROVIDER_ERROR_RATE=0.01
FAKE_PROVIDER_HANG_RATE=0.005
