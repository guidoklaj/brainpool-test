FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.115.0" "uvicorn[standard]>=0.32.0"

COPY fake_provider/ /app/fake_provider/

# Single worker on purpose: the provider is the authoritative quota source, so
# its counters must live in one process.
CMD ["uvicorn", "fake_provider.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
